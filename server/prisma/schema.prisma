generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALES
  MANAGER
  OPS
  FINANCE
  SUPER_ADMIN
}

// Site media type is now admin-managed data (see the MediaType model), so the
// Site.type column is a free string keyed by MediaType.code rather than a fixed
// enum — new media (gantry, unipole, digital…) can be added without a migration.

enum SiteStatus {
  AVAILABLE
  TENTATIVE
  BOOKED
  MAINTENANCE
  HOLD
}

enum BookingType {
  REGULAR
  LOOSE
}

// Per-site line status inside an order
enum BookingStatus {
  TENTATIVE
  CONFIRMED
  LIVE
  COMPLETED
  CANCELLED
  WAITLIST
  STOPPED
}

// Order / quotation lifecycle
enum OrderStatus {
  QUOTATION
  CONFIRMED
  LIVE
  COMPLETED
  CANCELLED
}

enum TaxCategory {
  GST
  NON_GST
}

enum PhotoPhase {
  START
  MID
  END
}

// Each monitoring day needs three kinds of proof
enum PhotoKind {
  GPS
  NORMAL
  NEWSPAPER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum LedgerType {
  DEBIT
  CREDIT
}

enum PaymentMode {
  CASH
  UPI
  BANK
  CHEQUE
  CARD
}

// Whether the client pays up front (ADVANCE) or after the display runs (POSTPAID).
enum PaymentTerms {
  ADVANCE
  POSTPAID
}

// Sensitive actions a staff member may request but only an admin/manager may
// carry out — the two-step approval queue (delete campaign/invoice, switch a
// GST campaign to cash at billing, disable a user…).
enum ApprovalAction {
  DELETE_ORDER
  CANCEL_ORDER
  DELETE_INVOICE
  SETTLE_CASH
  DISABLE_USER
  EDIT_PAYMENT
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(SALES)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  orders          Order[]           @relation("OrderBy")
  photos          MonitoringPhoto[] @relation("UploadedBy")
  invoices        Invoice[]         @relation("GeneratedBy")
  payments        Payment[]         @relation("PaymentBy")
  shifts          SiteShift[]       @relation("ShiftedBy")
  notes           Note[]            @relation("UserNotes")
  partnerPayments PartnerPayment[]  @relation("PartnerPaymentBy")

  approvalsRequested ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsReviewed  ApprovalRequest[] @relation("ApprovalReviewedBy")
}

// Operating entity — Saangari Ads (Non-GST only) vs Saangari Company (GST mandatory)
model Company {
  id                 Int      @id @default(autoincrement())
  code               String   @unique // "SAANGARI_ADS" | "SAANGARI_COMPANY"
  name               String // Display name
  legalName          String? // For invoice / quotation header
  gstin              String?
  pan                String?
  address            String?
  phone              String?
  email              String?
  gstMandatory       Boolean  @default(false) // true → booking must be GST
  gstHidden          Boolean  @default(false) // true → GST option hidden on booking form
  brandColor         String? // sidebar/brand hex, e.g. "#9E2015" (maroon)
  termsAndConditions String? // T&Cs appended to quotation PDFs
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  orders   Order[]
  invoices Invoice[]
  payments Payment[]
  ledger   LedgerEntry[]
}

// Client-managed booking categories (institute, hospital, coaching, events…)
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  orders  Order[]
  clients Client[]
}

// Admin-managed site media types (unipole, gantry, kiosk, hoarding, digital…).
// Site.type stores the `code`; the Inventory tabs and filters read from here so
// a new medium can be added at any time without a code change or migration.
model MediaType {
  id        Int      @id @default(autoincrement())
  code      String   @unique // stored on Site.type, e.g. "GANTRY"
  label     String // display name, e.g. "Gantry"
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Client {
  id          Int         @id @default(autoincrement())
  name        String
  phone       String      @unique
  email       String?
  company     String?
  gstNumber   String?
  taxCategory TaxCategory @default(NON_GST)
  state       String?     @default("Rajasthan")
  address     String?
  createdAt   DateTime    @default(now())

  // The client's line of business (hospital, coaching, …). Orders inherit it, so
  // the category is maintained once per client rather than picked per booking.
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId Int?

  orders   Order[]
  invoices Invoice[]
  ledger   LedgerEntry[]
  payments Payment[]
  contacts ClientContact[]
}

// Named contacts on a client account (owner, accounts person, on-site coordinator).
// The one flagged `billsTo` is the default recipient for invoices sent over
// WhatsApp/email; falls back to the client's own phone/email when none is set.
model ClientContact {
  id        Int      @id @default(autoincrement())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  Int
  name      String
  role      String? // e.g. "Accounts", "Owner", "Coordinator"
  phone     String?
  email     String?
  billsTo   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Site {
  id           Int        @id @default(autoincrement())
  code         String     @unique
  srNo         Int?
  zone         String
  city         String
  location     String
  light        String     @default("NL")
  width        Float      @default(0)
  height       Float      @default(0)
  qty          Int        @default(1)
  sqft         Float      @default(0)
  type         String // MediaType.code — e.g. "UNIPOLE", "GANTRY"
  imageUrl     String?
  printingCost Float      @default(0)
  mountingCost Float      @default(0)
  monthlyRate  Float      @default(0)
  // Explicit per-day rate for loose media (unipole spots sold by the day). When
  // 0 the day rate falls back to monthlyRate / 30.
  dayRate      Float      @default(0)
  gstOnRate    Boolean    @default(true)
  latitude     Float?
  longitude    Float?
  status       SiteStatus @default(AVAILABLE)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  // Lightweight manual hold — no quotation/booking, just "keep this free for now".
  holdNote  String?
  holdUntil DateTime?

  bookings   Booking[]
  shiftsFrom SiteShift[] @relation("ShiftFrom")
  shiftsTo   SiteShift[] @relation("ShiftTo")
}

model PrintingPartner {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String?
  phone       String?
  email       String?
  address     String?
  gstin       String? // partner's GSTIN (for their bills / statement)
  machines    String? // printing machines / equipment the partner runs (free text)
  ratePerSqft Float    @default(0)
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())

  materials PrintingMaterial[]
  orders    Order[]
  payments  PartnerPayment[]
}

// A payment WE make to a printing partner (settling what we owe them for jobs).
// Partner balance owed = Σ(order.printCost for their orders) − Σ(these payments).
model PartnerPayment {
  id           Int             @id @default(autoincrement())
  partner      PrintingPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId    Int
  amount       Float
  mode         PaymentMode     @default(BANK)
  reference    String?
  notes        String?
  paidAt       DateTime        @default(now())
  recordedBy   User            @relation("PartnerPaymentBy", fields: [recordedById], references: [id])
  recordedById Int
  createdAt    DateTime        @default(now())
}

model PrintingMaterial {
  id        Int             @id @default(autoincrement())
  partner   PrintingPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId Int
  name      String // e.g. "Flex", "Pamphlet", "White Back"
  rate      Float           @default(0) // CUSTOMER charge for this material (per print) — what we bill
  // What the PARTNER charges US per sqft for this material (the cost side). Black
  // Base ₹7.5/sqft, White Base ₹5.5/sqft — used to derive the printing payable.
  costPerSqft Float         @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@unique([partnerId, name])
}

// Order = quotation / booking order header for a single client.
// Holds commercial terms shared across many site line-items.
model Order {
  id          Int         @id @default(autoincrement())
  orderNo     String      @unique
  client      Client      @relation(fields: [clientId], references: [id])
  clientId    Int
  createdBy   User        @relation("OrderBy", fields: [createdById], references: [id])
  createdById Int
  company     Company     @relation(fields: [companyId], references: [id])
  companyId   Int         @default(1)
  status      OrderStatus @default(QUOTATION)

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId Int?

  bookingDate DateTime @default(now())
  description String?

  // Printing
  printingPartner   PrintingPartner? @relation(fields: [printingPartnerId], references: [id])
  printingPartnerId Int?
  printMaterial     String? // chosen material name (flex, pamphlet…) for the record
  noOfPrints        Int              @default(0)
  printRate         Float            @default(0)
  printingTotal     Float            @default(0)
  // What we PAY the printing partner for this order's printing (the cost side).
  // Internal only — never part of the customer's taxable amount. Printing margin
  // = printingTotal (charged) − printCost (paid). Feeds the partner payable ledger.
  printCost         Float            @default(0)

  // Mounting (30-day mounting cycle)
  mountingCost Float @default(0)

  // Monitoring plan → drives reminders
  monitoring   Boolean @default(false)
  monitorStart Boolean @default(false)
  monitorMid   Boolean @default(false)
  monitorEnd   Boolean @default(false)

  // Tax
  taxCategory   TaxCategory @default(NON_GST)
  interState    Boolean     @default(false)
  placeOfSupply String?     @default("Rajasthan")

  // Commercials (computed + stored)
  paymentTerms    PaymentTerms @default(ADVANCE)
  discountPct     Float        @default(0)
  discountRemarks String?
  rentalSubtotal  Float        @default(0)
  addOnTotal      Float        @default(0)
  discountAmount  Float        @default(0)
  taxableAmount   Float        @default(0)
  cgst            Float        @default(0)
  sgst            Float        @default(0)
  igst            Float        @default(0)
  gstAmount       Float        @default(0)
  grandTotal      Float        @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     Booking[]
  addOns    OrderAddOn[]
  payments  Payment[]
  reminders Reminder[]
  invoices  Invoice[]
}

model OrderAddOn {
  id      Int    @id @default(autoincrement())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId Int
  label   String
  amount  Float  @default(0)
}

// A single site line inside an order
model Booking {
  id        Int           @id @default(autoincrement())
  bookingNo String        @unique
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  site      Site          @relation(fields: [siteId], references: [id])
  siteId    Int
  type      BookingType   @default(REGULAR)
  status    BookingStatus @default(TENTATIVE)
  startDate DateTime
  endDate   DateTime
  days      Int
  dayRate   Float
  subtotal  Float

  // Free-text note that prints on the billing plan (quotation + invoice)
  displayNotes String?
  // Set when the display is stopped early
  stoppedAt    DateTime?
  stopReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos MonitoringPhoto[]
  shifts SiteShift[]
}

// Audit trail: a booking line moved from one site to another mid-campaign
model SiteShift {
  id         Int      @id @default(autoincrement())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  Int
  fromSite   Site     @relation("ShiftFrom", fields: [fromSiteId], references: [id])
  fromSiteId Int
  toSite     Site     @relation("ShiftTo", fields: [toSiteId], references: [id])
  toSiteId   Int
  reason     String?
  shiftedAt  DateTime @default(now())
  by         User     @relation("ShiftedBy", fields: [byId], references: [id])
  byId       Int
}

model MonitoringPhoto {
  id           Int        @id @default(autoincrement())
  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId    Int
  phase        PhotoPhase
  kind         PhotoKind  @default(NORMAL)
  filePath     String
  latitude     Float?
  longitude    Float?
  takenAt      DateTime   @default(now())
  uploadedBy   User       @relation("UploadedBy", fields: [uploadedById], references: [id])
  uploadedById Int
  remarks      String?

  // One photo per (line, phase, kind) — re-uploading replaces it
  @@unique([bookingId, phase, kind])
}

// In-app monitoring reminder for an order phase (START / MID / END)
model Reminder {
  id        Int        @id @default(autoincrement())
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  phase     PhotoPhase
  dueDate   DateTime
  done      Boolean    @default(false)
  createdAt DateTime   @default(now())
}

model Payment {
  id        Int         @id @default(autoincrement())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  client    Client      @relation(fields: [clientId], references: [id])
  clientId  Int
  company   Company     @relation(fields: [companyId], references: [id])
  companyId Int         @default(1)
  // Gross amount settled against the order. TDS is remitted to the government
  // on the client's behalf, so the order is credited with `amount`, while
  // `netReceived` is what actually landed in the bank.
  amount    Float
  mode      PaymentMode @default(CASH)

  tdsApplicable Boolean @default(false)
  tdsPct        Float   @default(0)
  tdsAmount     Float   @default(0)
  netReceived   Float   @default(0)

  reference     String?
  notes         String?
  receivedAt    DateTime      @default(now())
  recordedBy    User          @relation("PaymentBy", fields: [recordedById], references: [id])
  recordedById  Int
  // The client-ledger credit(s) this payment posted, so an edit can adjust the
  // exact matching entry instead of guessing by narration.
  ledgerEntries LedgerEntry[]
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNo     String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       Int
  client        Client        @relation(fields: [clientId], references: [id])
  clientId      Int
  company       Company       @relation(fields: [companyId], references: [id])
  companyId     Int           @default(1)
  taxCategory   TaxCategory
  interState    Boolean       @default(false)
  amount        Float
  gstRate       Float         @default(18)
  cgst          Float         @default(0)
  sgst          Float         @default(0)
  igst          Float         @default(0)
  gstAmount     Float         @default(0)
  total         Float
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime      @default(now())
  // When payment is due. Defaults to the last working day of the issue month
  // (monthly billing), editable before the invoice is finalised.
  dueDate       DateTime?
  generatedBy   User          @relation("GeneratedBy", fields: [generatedById], references: [id])
  generatedById Int

  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id        Int        @id @default(autoincrement())
  client    Client     @relation(fields: [clientId], references: [id])
  clientId  Int
  company   Company    @relation(fields: [companyId], references: [id])
  companyId Int        @default(1)
  invoice   Invoice?   @relation(fields: [invoiceId], references: [id])
  invoiceId Int?
  payment   Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentId Int?
  type      LedgerType
  amount    Float
  narration String
  date      DateTime   @default(now())
}

model Counter {
  key   String @id
  value Int    @default(0)
}

model Note {
  id        Int      @id @default(autoincrement())
  content   String
  isDone    Boolean  @default(false)
  user      User     @relation("UserNotes", fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Two-step approval: a staff member requests a sensitive action, an admin /
// manager approves (which executes it) or rejects. Doubles as an audit log.
model ApprovalRequest {
  id            Int            @id @default(autoincrement())
  action        ApprovalAction
  status        ApprovalStatus @default(PENDING)
  entityType    String // "order" | "invoice" | "user"
  entityId      Int?
  label         String? // human summary shown in the queue, e.g. "SO-00012 · Motion"
  reason        String?
  payload       Json? // extra data needed to execute (e.g. { taxCategory: "NON_GST" })
  requestedBy   User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  requestedById Int
  reviewedBy    User?          @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id])
  reviewedById  Int?
  reviewNote    String?
  createdAt     DateTime       @default(now())
  reviewedAt    DateTime?
}

// Lightweight activity feed: a human-readable record of the actions worth
// showing in the notification panel's "Activity" tab — a payment received, a
// booking created, an invoice raised, an edit, a cancellation. Kept denormalised
// (orderNo, userName stored inline) so the feed reads without extra joins and a
// deleted order/user never breaks the history. Best-effort: logging never blocks
// the underlying mutation.
model ActivityLog {
  id        Int      @id @default(autoincrement())
  type      String // PAYMENT | PAYMENT_EDIT | BOOKING | CAMPAIGN_EDIT | INVOICE | ADDON | SITE_SHIFT | CANCEL
  summary   String
  detail    String?
  orderId   Int?
  orderNo   String?
  invoiceId Int?
  userId    Int?
  userName  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
